#!/usr/bin/env bash
set -euo pipefail
[[ $# -eq 1 ]] || { echo "usage: integrate-task TASK_FILE" >&2; exit 2; }
script_dir=$(cd "$(dirname "$0")" && pwd); root=$(git rev-parse --show-toplevel)
[[ -f "$(git rev-parse --git-common-dir)/hci-orchestrator.lock/owner" ]] || { echo "Phải giữ khóa orchestrator." >&2; exit 1; }
[[ $(git branch --show-current) == main ]] || { echo "Chỉ tích hợp từ main." >&2; exit 1; }
python3 "$script_dir/tasklib.py" "$1"
status=$(sed -n 's/^status:[[:space:]]*//p' "$1" | head -n1); [[ "$status" == review ]] || { echo "Task phải ở trạng thái review." >&2; exit 1; }
handoff=$(sed -n 's/^handoff:[[:space:]]*//p' "$1" | head -n1); grep -Eiq 'Kết luận:[[:space:]]*`?approved`?' "$handoff" || { echo "Review chưa approved." >&2; exit 1; }
branch=$(sed -n 's/^branch:[[:space:]]*//p' "$1" | head -n1)
protected_changed=$(python3 "$script_dir/tasklib.py" --validate-integration "$1" main "$branch")
git merge --no-ff "$branch"
if [[ -n "$protected_changed" ]]; then
  mapfile -t artifacts <<< "$protected_changed"
  python3 "$script_dir/tasklib.py" --advance-integrated-artifacts "${artifacts[@]}"
fi
sed -i 's/^status:[[:space:]]*review/status: done/' "$1"
python3 "$script_dir/tasklib.py" "$1"
echo "Đã tích hợp $branch; hãy commit cập nhật trạng thái task."
