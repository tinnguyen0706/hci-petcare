#!/usr/bin/env bash
set -euo pipefail
[[ $# -eq 1 ]] || { echo "usage: integrate-task TASK_FILE" >&2; exit 2; }
script_dir=$(cd "$(dirname "$0")" && pwd)
PYTHON=${PYTHON:-$(command -v python3 || command -v python)}
[[ -n "$PYTHON" ]] || { echo "Không tìm thấy python3 hoặc python." >&2; exit 1; }
command -v gh >/dev/null 2>&1 || { echo "Cần cài GitHub CLI (gh). Xem https://cli.github.com/" >&2; exit 1; }
root=$(git rev-parse --show-toplevel)
[[ -f "$(git rev-parse --git-common-dir)/hci-orchestrator.lock/owner" ]] || { echo "Phải giữ khóa orchestrator." >&2; exit 1; }
[[ $(git branch --show-current) == main ]] || { echo "Chỉ tích hợp từ main." >&2; exit 1; }
"$PYTHON" "$script_dir/tasklib.py" "$1"
status=$(sed -n 's/^status:[[:space:]]*//p' "$1" | head -n1)
[[ "$status" == review ]] || { echo "Task phải ở trạng thái review." >&2; exit 1; }
handoff=$(sed -n 's/^handoff:[[:space:]]*//p' "$1" | head -n1)
grep -Eiq 'Kết luận:[[:space:]]*`?approved`?' "$handoff" || { echo "Review chưa approved." >&2; exit 1; }
branch=$(sed -n 's/^branch:[[:space:]]*//p' "$1" | head -n1)
task_id=$(sed -n 's/^id:[[:space:]]*//p' "$1" | head -n1)
protected_changed=$("$PYTHON" "$script_dir/tasklib.py" --validate-integration "$1" main "$branch")
# Push branch lên remote và tạo Pull Request
git push -u origin "$branch"
pr_url=$(gh pr create --base main --head "$branch" \
  --title "merge: integrate $task_id" \
  --body "Handoff: \`$handoff\`")
echo "Đã tạo PR: $pr_url"
# Merge PR (merge commit giống --no-ff)
gh pr merge "$pr_url" --merge --delete-branch
# Cập nhật main cục bộ
git checkout main && git pull origin main
# Cập nhật metadata (artifact + status)
if [[ -n "$protected_changed" ]]; then
  mapfile -t artifacts <<< "$protected_changed"
  "$PYTHON" "$script_dir/tasklib.py" --advance-integrated-artifacts "${artifacts[@]}"
fi
sed -i 's/^status:[[:space:]]*review/status: done/' "$1"
"$PYTHON" "$script_dir/tasklib.py" "$1"
echo "Đã tích hợp $task_id qua PR; hãy commit cập nhật trạng thái task."
