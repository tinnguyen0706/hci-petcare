#!/usr/bin/env bash
set -euo pipefail
[[ $# -eq 1 ]] || { echo "usage: validate-task TASK_FILE" >&2; exit 2; }
PYTHON=${PYTHON:-$(command -v python3 || command -v python)}
[[ -n "$PYTHON" ]] || { echo "Không tìm thấy python3 hoặc python." >&2; exit 1; }
exec "$PYTHON" "$(dirname "$0")/tasklib.py" "$1"
