#!/usr/bin/env bash
set -euo pipefail
[[ $# -eq 1 ]] || { echo "usage: create-agent-worktree TASK_FILE" >&2; exit 2; }
script_dir=$(cd "$(dirname "$0")" && pwd)
python3 "$script_dir/tasklib.py" "$1"
read_field() { sed -n "s/^$1:[[:space:]]*//p" "$2" | head -n1 | tr -d "'\""; }
branch=$(read_field branch "$1"); target=$(read_field worktree "$1")
[[ ! -e "$target" ]] || { echo "Worktree đã tồn tại: $target" >&2; exit 1; }
git show-ref --verify --quiet "refs/heads/$branch" && git worktree add "$target" "$branch" || git worktree add -b "$branch" "$target" HEAD
